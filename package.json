{
  "name": "chevoink-web",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "type": "module",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "client:dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:client": "vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:verify": "tsx scripts/assert-test-database.ts",
    "test:db:migrate": "tsx scripts/migrate-test-database.ts",
    "audit:baseline": "tsx scripts/capture-engineering-baseline.ts",
    "runtime:verify": "tsx scripts/assert-runtime.ts",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "voice:prepare": "node scripts/prepare-voice-assets.mjs",
    "deploy:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy-production.ps1",
    "server:dev": "nodemon",
    "start:server": "tsx api/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "cleanup:demo-data": "node scripts/cleanup-demo-data.mjs",
    "agent2:ops": "tsx scripts/agent2-ops.ts",
    "agent3:eval": "tsx scripts/agent3-eval.ts",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\""
  },
  "dependencies": {
    "@capacitor/core": "8.4.2",
    "@milkdown/crepe": "^7.22.1",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "6.12.0",
    "@tanstack/react-query": "^5.83.0",
    "@tauri-apps/api": "2.11.1",
    "@xyflow/react": "^12.8.6",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "iconv-lite": "^0.7.3",
    "jsonrepair": "3.15.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^0.511.0",
    "mammoth": "^1.12.1",
    "mdast-util-from-markdown": "2.0.3",
    "modern-screenshot": "^4.7.0",
    "node-edge-tts": "^1.2.10",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "^7.3.0",
    "remark-gfm": "4.0.1",
    "sharp": "^0.35.5",
    "svg-captcha": "^1.4.0",
    "tailwind-merge": "^3.0.2",
    "tencentcloud-sdk-nodejs-sms": "^4.1.240",
    "undici": "^8.11.2",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.30",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "autoprefixer": "^10.4.21",
    "braces": "file:vendor/braces",
    "concurrently": "^9.2.4",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.0.1",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "prisma": "6.12.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.2.7"
  },
  "overrides": {
    "vitest": {
      "tinypool": "2.1.2"
    },
    "@xmldom/xmldom": "0.8.15",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7",
    "brace-expansion@5": "5.0.12",
    "braces": "$braces",
    "browserslist": "4.28.7",
    "concurrently": {
      "shell-quote": "1.11.0"
    },
    "dompurify": "3.4.16",
    "js-yaml": "4.3.2",
    "qs": "6.16.0",
    "uuid": "^11.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
