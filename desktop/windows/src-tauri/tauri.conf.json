{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chevoink",
  "version": "1.0.10",
  "identifier": "com.chevoink.desktop",
  "build": { "frontendDist": "../shell-ui" },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "plugins": { "updater": { "pubkey": "", "endpoints": [] } },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "AI-assisted long-form writing workspace",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "icons/setup-sidebar.bmp",
        "headerImage": "icons/setup-header.bmp",
        "template": "installer.nsi",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
