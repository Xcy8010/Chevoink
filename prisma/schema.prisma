generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  author
  admin
}

enum NovelStatus {
  draft
  published
  completed
  archived
}

enum ChapterStatus {
  draft
  published
  scheduled
  archived
}

enum Visibility {
  public
  followers
  private
}

enum CommentTargetType {
  novel
  chapter
  post
}

enum MessageType {
  text
  image
  novelCard
  postCard
  authorCard
  commentCard
  system
}

enum ConversationType {
  direct
  system
}

enum CoverSourceType {
  upload
  ai_generated
}

enum ContentAuditStatus {
  pending
  approved
  rejected
}

enum AiProviderType {
  text
  image
}

enum AgentSessionStatus {
  active
  archived
}

enum AgentRunMode {
  plan
  act
  review
}

enum AgentRunStatus {
  queued
  running
  awaiting_approval
  paused
  completed
  failed
  cancelled
}

enum AgentType {
  writingOrchestrator
  storyPlanner
  draftWriter
  continuityEditor
  styleEditor
  loreLibrarian
  coverPromptAgent
}

enum AgentActionKind {
  planChapter
  draftChapter
  continueChapter
  rewriteSelection
  polishSelection
  reviewContinuity
  generateCoverPrompt
  workspaceAgent
}

enum AgentArtifactType {
  researchReport
  chapterPlan
  chapterDraft
  chapterContinuation
  rewriteSelection
  polishSelection
  continuityReview
  coverPrompt
  searchResult
  contextCheckpoint
}

enum ProjectMemoryType {
  novelSummary
  worldbuilding
  characterCard
  chapterSummary
  timelineEvent
  foreshadowing
  stylePreference
  continuityRule
  volumeSummary
  storyArc
  sceneState
  relationshipState
  storyBible
  authorProfile
}

enum StoryMemoryLayer {
  L0
  L1
  L2
  L3
}

enum StoryMemoryStatus {
  confirmed
  inferred
  conflicted
  superseded
  invalid
}

enum MemoryReviewStatus {
  none
  pending
  accepted
  rejected
}

enum MemorySourceType {
  chapter
  volume
  message
  author_input
  artifact
}

enum MemoryJobStatus {
  pending
  processing
  completed
  failed
}

enum ChangeSetStatus {
  draft
  approved
  applying
  applied
  conflicted
  failed
  rolled_back
}

enum UserDirectiveScope {
  global
  volume
  chapter
  task
}

enum UserDirectiveKind {
  goal
  must
  must_not
  preference
  decision
}

enum UserDirectiveStatus {
  active
  fulfilled
  superseded
  cancelled
}

enum StoryCompilerMode {
  balanced
  premium
}

enum StoryCompilationStage {
  prepare
  beat
  write
  check
  repair
  commit
}

enum StoryCompilationStatus {
  active
  completed
  abandoned
  failed
}

enum SceneTaskStatus {
  ready
  writing
  completed
  abandoned
}

enum ReaderPromiseStatus {
  open
  paid
  deferred
  abandoned
}

enum ChapterQualityStatus {
  analyzing
  needs_repair
  passed
  repaired
  stale
  failed
}

enum QualityFindingSource {
  deterministic
  critic
}

enum QualityFindingSeverity {
  advisory
  warning
  error
}

enum QualityFindingDisposition {
  pending
  selected
  repaired
}

enum QualityFindingFeedback {
  accepted
  rejected
}

enum CreativeProfileStatus {
  draft
  confirmed
  archived
}

enum CorpusSourceClass {
  internal
  public_domain
  permissive
  licensed
  author_private
  platform_opt_in
}

enum CorpusRightsStatus {
  pending
  approved
  rejected
  expired
  revoked
}

enum CorpusScope {
  platform
  user
  novel
}

enum CorpusDocumentStatus {
  pending
  indexed
  blocked
  revoked
}

enum StyleProfileKind {
  author
  corpus
}

enum LeakageDecision {
  passed
  blocked
}

enum SmsVerificationPurpose {
  login
  register
  reset_password
  admin_login
  admin_bind
}

/// 隐私可见级别：公开 / 仅自己 / 仅互关可见
enum PrivacyLevel {
  public
  private
  mutual
}

model User {
  novelImportJobs NovelImportJob[]
  novelImportIntents NovelImportIntent[]
  id                         String                  @id @default(cuid()) @db.VarChar(64)
  email                      String?                 @unique @db.VarChar(255)
  phone                      String?                 @unique @db.VarChar(32)
  passwordHash               String                  @map("password_hash") @db.VarChar(255)
  nickname                   String                  @db.VarChar(64)
  avatarUrl                  String?                 @map("avatar_url")
  profileCoverUrl            String?                 @map("profile_cover_url")
  bio                        String?
  role                       UserRole                @default(user)
  /**
   * 超级管理（唯一）：仅该账号可在后台设置用户身份（用户↔管理）
   */
  isSuperAdmin               Boolean                 @default(false) @map("is_super_admin")
  isAuthor                   Boolean                 @default(false) @map("is_author")
  followerCount              Int                     @default(0) @map("follower_count")
  followingCount             Int                     @default(0) @map("following_count")
  novelCount                 Int                     @default(0) @map("novel_count")
  postCount                  Int                     @default(0) @map("post_count")
  unreadMessageCount         Int                     @default(0) @map("unread_message_count")
  unreadNotificationCount    Int                     @default(0) @map("unread_notification_count")
  /**
   * 会话令牌版本：改密/登出/封禁时 +1，即刻吊销该用户全部 v2 会话令牌
   */
  tokenVersion               Int                     @default(0) @map("token_version")
  interactionsSeenAt         DateTime?               @map("interactions_seen_at")
  followersSeenAt            DateTime?               @map("followers_seen_at")
  lastActiveAt               DateTime?               @map("last_active_at")
  /**
   * 封禁时间（NULL = 正常）：后台管理封禁后全站登录态失效
   */
  bannedAt                   DateTime?               @map("banned_at")
  privacyFollowers           PrivacyLevel            @default(public) @map("privacy_followers")
  privacyFollowing           PrivacyLevel            @default(public) @map("privacy_following")
  privacyLikes               PrivacyLevel            @default(public) @map("privacy_likes")
  privacyFavorites           PrivacyLevel            @default(public) @map("privacy_favorites")
  privacyReplies             PrivacyLevel            @default(public) @map("privacy_replies")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")
  novels                     Novel[]
  chapters                   Chapter[]
  comments                   Comment[]
  posts                      Post[]
  sharedInPosts              Post[]                  @relation("PostSharedUser")
  coverAssets                CoverAsset[]
  conversationMembers        ConversationMember[]
  messages                   Message[]
  aiUsageLogs                AiUsageLog[]
  creditAccount              CreditAccount?
  creditLedgerEntries        CreditLedgerEntry[]
  referralCode               ReferralCode?
  sentReferralRedemptions    ReferralRedemption[]    @relation("ReferralInviter")
  receivedReferralRedemption ReferralRedemption?     @relation("ReferralInvitee")
  aiModelConfigs             AiModelConfig[]
  agentSessions              AgentSession[]
  agentRuns                  AgentRun[]
  durableTaskRoots           AgentTaskRoot[]
  legacyAgentAttachmentGrants LegacyAgentAttachmentGrant[]
  smsVerificationCodes       SmsVerificationCode[]
  postLikes                  PostLike[]
  postBookmarks              PostBookmark[]
  commentLikes               CommentLike[]
  novelFavorites             NovelFavorite[]
  readingProgress            ReadingProgress[]
  novelReads                 NovelRead[]
  paragraphUnderlines        ParagraphUnderline[]
  changeSets                 ChangeSet[]
  userDirectives             UserDirective[]
  storyCharters              StoryCharter[]
  readerPromises             ReaderPromise[]
  storyCompilations          StoryCompilation[]
  sceneTasks                 SceneTask[]
  chapterBridges             ChapterBridge[]
  characterVoiceProfiles     CharacterVoiceProfile[]
  experienceAnchors          ExperienceAnchor[]
  chapterQualityReports      ChapterQualityReport[]
  qualityFindings            QualityFinding[]
  ownedCorpusSources         CorpusSource[]          @relation("CorpusSourceOwner")
  auditedCorpusSources       CorpusSource[]          @relation("CorpusSourceAuditor")
  corpusDocuments            CorpusDocument[]
  corpusPassages             CorpusPassage[]
  techniqueCards             TechniqueCard[]
  styleProfiles              StyleProfile[]
  retrievalTraces            RetrievalTrace[]
  leakageChecks              LeakageCheck[]
  corpusDeletionReceipts     CorpusDeletionReceipt[]
  researchDossiers           ResearchDossier[]
  firstThreePrototypes       FirstThreePrototype[]
  writingExperiments         WritingExperiment[]
  agentDataControls          AgentDataControl[]
  sentSkillShareInvites      SkillShareInvite[]      @relation("SkillShareInviteSender")
  receivedSkillShareInvites  SkillShareInvite[]      @relation("SkillShareInviteRecipient")
  storyBranches              StoryBranch[]
  agentSubtasks              AgentSubtask[]
  agentSubtaskRuns           AgentSubtaskRun[]
  agentSchedules             AgentSchedule[]
  agentEvalComparisons       AgentEvalComparison[]
  following                  UserFollow[]            @relation("UserFollowFollower")
  followers                  UserFollow[]            @relation("UserFollowFollowing")
  feedbacks                  Feedback[]

  @@map("users")
}

model SmsVerificationCode {
  id         String                 @id @default(cuid()) @db.VarChar(64)
  userId     String?                @map("user_id") @db.VarChar(64)
  phone      String                 @db.VarChar(32)
  purpose    SmsVerificationPurpose
  codeHash   String                 @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime               @map("expires_at")
  consumedAt DateTime?              @map("consumed_at")
  attempts   Int                    @default(0)
  provider   String                 @default("tencentcloud") @db.VarChar(32)
  meta       Json?
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")
  user       User?                  @relation(fields: [userId], references: [id])

  @@index([phone, purpose, createdAt])
  @@index([userId])
  @@index([expiresAt])
  @@map("sms_verification_codes")
}

model Novel {
  manuscriptRevision Int @default(0) @map("manuscript_revision")
  importJobs NovelImportJob[]
  importIntents NovelImportIntent[]
  id                     String                  @id @default(cuid()) @db.VarChar(64)
  authorId               String                  @map("author_id") @db.VarChar(64)
  title                  String                  @db.VarChar(128)
  displayTitle           String?                 @map("display_title") @db.VarChar(128)
  slug                   String                  @unique @db.VarChar(160)
  summary                String
  categoryId             String?                 @map("category_id") @db.VarChar(64)
  categoryName           String?                 @map("category_name") @db.VarChar(64)
  tagNames               String[]                @default([]) @map("tag_names")
  status                 NovelStatus             @default(draft)
  visibility             Visibility              @default(public)
  coverAssetId           String?                 @unique @map("cover_asset_id") @db.VarChar(64)
  coverPrompt            String?                 @map("cover_prompt")
  wordCount              Int                     @default(0) @map("word_count")
  chapterCount           Int                     @default(0) @map("chapter_count")
  commentCount           Int                     @default(0) @map("comment_count")
  favoriteCount          Int                     @default(0) @map("favorite_count")
  likeCount              Int                     @default(0) @map("like_count")
  viewCount              Int                     @default(0) @map("view_count")
  lastChapterTitle       String?                 @map("last_chapter_title") @db.VarChar(128)
  lastPublishedAt        DateTime?               @map("last_published_at")
  publishedAt            DateTime?               @map("published_at")
  pinnedAt               DateTime?               @map("pinned_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  author                 User                    @relation(fields: [authorId], references: [id])
  coverAsset             CoverAsset?             @relation("NovelCover", fields: [coverAssetId], references: [id])
  coverAssets            CoverAsset[]            @relation("CoverAssetCandidates")
  chapters               Chapter[]
  volumes                Volume[]
  comments               Comment[]
  favorites              NovelFavorite[]
  posts                  Post[]
  aiUsageLogs            AiUsageLog[]
  agentSessions          AgentSession[]
  agentRuns              AgentRun[]
  projectMemoryEntries   ProjectMemoryEntry[]
  readingProgress        ReadingProgress[]
  novelReads             NovelRead[]
  recommendationEvents   RecommendationEvent[]
  changeSets             ChangeSet[]
  userDirectives         UserDirective[]
  storyEntities          StoryEntity[]
  storyEvents            StoryEvent[]
  memoryExtractionJobs   MemoryExtractionJob[]
  foreshadowThreads      ForeshadowThread[]
  storyCharter           StoryCharter?
  readerPromises         ReaderPromise[]
  storyCompilations      StoryCompilation[]
  sceneTasks             SceneTask[]
  chapterBridges         ChapterBridge[]
  characterVoiceProfiles CharacterVoiceProfile[]
  experienceAnchors      ExperienceAnchor[]
  chapterQualityReports  ChapterQualityReport[]
  qualityFindings        QualityFinding[]
  corpusSources          CorpusSource[]
  corpusDocuments        CorpusDocument[]
  corpusPassages         CorpusPassage[]
  techniqueCards         TechniqueCard[]
  styleProfiles          StyleProfile[]
  retrievalTraces        RetrievalTrace[]
  leakageChecks          LeakageCheck[]
  corpusDeletionReceipts CorpusDeletionReceipt[]
  researchDossiers       ResearchDossier[]
  firstThreePrototypes   FirstThreePrototype[]
  writingExperiments     WritingExperiment[]
  agentDataControls      AgentDataControl[]
  skillShareInvites      SkillShareInvite[]
  storyBranches          StoryBranch[]
  agentSubtasks          AgentSubtask[]
  agentSubtaskRuns       AgentSubtaskRun[]
  agentSchedules         AgentSchedule[]
  agentEvalComparisons   AgentEvalComparison[]

  @@index([authorId])
  @@index([status, visibility])
  @@index([categoryId])
  @@index([status, visibility, lastPublishedAt])
  @@index([authorId, updatedAt])
  @@index([authorId, pinnedAt])
  @@map("novels")
}

model Chapter {
  archivedAt           DateTime?              @map("archived_at")
  archivedByImportId   String?                @map("archived_by_import_id") @db.VarChar(64)
  id                   String                 @id @default(cuid()) @db.VarChar(64)
  novelId              String                 @map("novel_id") @db.VarChar(64)
  authorId             String                 @map("author_id") @db.VarChar(64)
  title                String                 @db.VarChar(128)
  summary              String?
  content              String
  orderIndex           Int                    @map("order_index")
  volumeId             String                 @map("volume_id") @db.VarChar(64)
  orderInVolume        Int                    @map("order_in_volume")
  wordCount            Int                    @default(0) @map("word_count")
  status               ChapterStatus          @default(draft)
  visibility           Visibility             @default(public)
  commentCount         Int                    @default(0) @map("comment_count")
  revision             Int                    @default(1)
  publishedTitle       String?                @map("published_title") @db.VarChar(128)
  publishedSummary     String?                @map("published_summary")
  publishedContent     String?                @map("published_content")
  publishedWordCount   Int?                   @map("published_word_count")
  publishedRevision    Int?                   @map("published_revision")
  publishedAt          DateTime?              @map("published_at")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")
  novel                Novel                  @relation(fields: [novelId], references: [id])
  volume               Volume                 @relation(fields: [volumeId], references: [id], onDelete: Restrict)
  author               User                   @relation(fields: [authorId], references: [id])
  comments             Comment[]
  aiUsageLogs          AiUsageLog[]
  agentRuns            AgentRun[]
  projectMemoryEntries ProjectMemoryEntry[]
  paragraphUnderlines  ParagraphUnderline[]
  storyCompilations    StoryCompilation[]
  sceneTasks           SceneTask[]
  bridgesFrom          ChapterBridge[]        @relation("ChapterBridgeFrom")
  bridgesTo            ChapterBridge[]        @relation("ChapterBridgeTo")
  qualityReports       ChapterQualityReport[]
  storyBranches        StoryBranch[]

  // Active-only uniqueness is maintained by SQL partial indexes (Prisma 6).
  @@index([novelId, archivedAt])
  @@index([novelId, status])
  @@index([volumeId, orderInVolume])
  @@map("chapters")
}

model Volume {
  archivedAt DateTime? @map("archived_at")
  archivedByImportId String? @map("archived_by_import_id") @db.VarChar(64)
  id         String    @id @default(cuid()) @db.VarChar(64)
  novelId    String    @map("novel_id") @db.VarChar(64)
  title      String    @db.VarChar(128)
  summary    String?
  orderIndex Int       @map("order_index")
  revision   Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  novel      Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters   Chapter[]

  // Active-only uniqueness is maintained by SQL partial indexes (Prisma 6).
  @@index([novelId, archivedAt])
  @@index([novelId])
  @@map("volumes")
}

model NovelImportIntent {
  id String @id @db.VarChar(64)
  userId String @db.VarChar(64)
  novelId String @db.VarChar(64)
  agentRunId String? @db.VarChar(64)
  agentToolCallId String? @db.VarChar(255)
  targetHash String @db.VarChar(64)
  overwriteRequired Boolean
  confirmationStep Int @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  jobs NovelImportJob[]
  @@index([userId, novelId, expiresAt])
  @@unique([agentRunId, agentToolCallId])
  @@map("novel_import_intents")
}

model NovelImportJob {
  id String @id @db.VarChar(64)
  userId String @db.VarChar(64)
  novelId String @db.VarChar(64)
  agentRunId String? @db.VarChar(64)
  agentToolCallId String? @db.VarChar(255)
  intentId String @unique @db.VarChar(64)
  status String @default("uploading") @db.VarChar(32)
  jobVersion Int @default(1)
  manifestRevision Int @default(0)
  manifestHash String? @db.VarChar(64)
  targetHash String @db.VarChar(64)
  modelSelection Json
  parseEncoding String? @db.VarChar(32)
  parseDeadlineAt DateTime?
  leaseOwner String? @db.VarChar(64)
  leaseEpoch Int @default(0)
  leaseUntil DateTime?
  errorCode String? @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  intent NovelImportIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  source NovelImportSource?
  manifests NovelImportManifest[]
  approvals NovelImportApproval[]
  commit NovelImportCommit?
  backup NovelImportBackup?
  artifacts NovelImportArtifact[]
  events NovelImportEvent[]
  @@index([userId, novelId, createdAt])
  @@unique([agentRunId, agentToolCallId])
  @@index([status, leaseUntil])
  @@map("novel_import_jobs")
}

model NovelImportSource {
  id String @id @db.VarChar(64)
  jobId String @unique @db.VarChar(64)
  filename String @db.VarChar(255)
  storageKey String @db.VarChar(128)
  sha256 String @db.VarChar(64)
  bytes Int
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@map("novel_import_sources")
}

model NovelImportArtifact {
  id String @id @db.Uuid
  jobId String @db.VarChar(64)
  kind String @db.VarChar(24)
  logicalId String @db.VarChar(255)
  storageKey String @db.VarChar(128)
  sha256 String @db.VarChar(64)
  bytes Int
  mediaType String @db.VarChar(128)
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId])
  @@unique([jobId, kind, sha256])
  @@map("novel_import_artifacts")
}

model NovelImportManifest {
  id String @id @db.VarChar(64)
  jobId String @db.VarChar(64)
  revision Int
  hash String @db.VarChar(64)
  storageKey String @db.VarChar(128)
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, revision])
  @@map("novel_import_manifests")
}

model NovelImportApproval {
  id String @id @db.VarChar(64)
  jobId String @db.VarChar(64)
  userId String @db.VarChar(64)
  kind String @db.VarChar(16)
  sourceHash String @db.VarChar(64)
  manifestHash String @db.VarChar(64)
  manifestRevision Int
  targetHash String @db.VarChar(64)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, kind])
  @@map("novel_import_approvals")
}

model NovelImportBackup {
  id String @id @db.VarChar(64)
  jobId String @unique @db.VarChar(64)
  // Retained row IDs + metadata; full bodies remain in their original rows.
  snapshot Json
  beforeHash String @db.VarChar(64)
  afterHash String @db.VarChar(64)
  expiresAt DateTime
  restoredAt DateTime?
  restoredApprovalId String? @unique @db.VarChar(64)
  restoreIdempotencyKey String? @db.VarChar(128)
  restoreReceipt Json?
  restoreErrorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@map("novel_import_backups")
}

model NovelImportCommit {
  jobId String @id @db.VarChar(64)
  approvalId String @unique @db.VarChar(64)
  idempotencyKey String @db.VarChar(128)
  receipt Json
  // Durable outbox marker: parent integration drains it without paid AI effects.
  effectsPublishedAt DateTime?
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([effectsPublishedAt, createdAt])
  @@map("novel_import_commits")
}

// DB delete triggers retain exact private keys for later bounded orphan cleanup.
model NovelImportGarbage {
  storageKey String @id @db.VarChar(128)
  createdAt DateTime @default(now())
  @@map("novel_import_garbage")
}

model NovelImportEvent {
  id String @id @db.Uuid
  jobId String @db.VarChar(64)
  kind String @db.VarChar(16)
  payload Json
  createdAt DateTime @default(now())
  job NovelImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@unique([jobId, kind])
  @@map("novel_import_events")
}

model ChangeSet {
  id           String           @id @default(cuid()) @db.VarChar(64)
  novelId      String           @map("novel_id") @db.VarChar(64)
  userId       String           @map("user_id") @db.VarChar(64)
  taskSpecId   String           @map("task_spec_id") @db.VarChar(64)
  status       ChangeSetStatus  @default(draft)
  baseRevision Int              @default(0) @map("base_revision")
  validations  Json
  snapshotId   String?          @map("snapshot_id") @db.VarChar(64)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  novel        Novel            @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  patches      ChangeSetPatch[]

  @@index([novelId, createdAt])
  @@index([userId, status])
  @@map("change_sets")
}

model ChangeSetPatch {
  id               String    @id @default(cuid()) @db.VarChar(64)
  changeSetId      String    @map("change_set_id") @db.VarChar(64)
  targetType       String    @map("target_type") @db.VarChar(24)
  targetId         String    @map("target_id") @db.VarChar(64)
  field            String    @db.VarChar(32)
  beforeHash       String    @map("before_hash") @db.VarChar(64)
  expectedRevision Int       @map("expected_revision")
  appliedRevision  Int?      @map("applied_revision")
  anchor           String?
  before           String?
  after            String?
  reason           String
  selected         Boolean   @default(true)
  createdAt        DateTime  @default(now()) @map("created_at")
  changeSet        ChangeSet @relation(fields: [changeSetId], references: [id], onDelete: Cascade)

  @@index([changeSetId, selected])
  @@index([targetType, targetId])
  @@map("change_set_patches")
}

model Comment {
  id             String             @id @default(cuid()) @db.VarChar(64)
  userId         String             @map("user_id") @db.VarChar(64)
  targetType     CommentTargetType  @map("target_type")
  targetId       String             @map("target_id") @db.VarChar(64)
  novelId        String?            @map("novel_id") @db.VarChar(64)
  chapterId      String?            @map("chapter_id") @db.VarChar(64)
  postId         String?            @map("post_id") @db.VarChar(64)
  parentId       String?            @map("parent_id") @db.VarChar(64)
  rootId         String?            @map("root_id") @db.VarChar(64)
  content        String
  /**
   * 作品评论的评星（1-5）；仅 targetType=novel 的根评论使用
   */
  rating         Int?
  /**
   * 段评：评论所属正文段落序号（0 起）；仅 targetType=chapter 的根评论使用
   */
  paragraphIndex Int?               @map("paragraph_index")
  likeCount      Int                @default(0) @map("like_count")
  replyCount     Int                @default(0) @map("reply_count")
  auditStatus    ContentAuditStatus @default(pending) @map("audit_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  author         User               @relation(fields: [userId], references: [id])
  novel          Novel?             @relation(fields: [novelId], references: [id])
  chapter        Chapter?           @relation(fields: [chapterId], references: [id])
  post           Post?              @relation(fields: [postId], references: [id])
  parent         Comment?           @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]          @relation("CommentReplies")
  likes          CommentLike[]

  @@index([targetType, targetId])
  @@index([targetType, targetId, createdAt])
  @@index([parentId])
  @@index([novelId])
  @@index([chapterId])
  @@index([postId])
  @@map("comments")
}

model Topic {
  id        String      @id @default(cuid()) @db.VarChar(64)
  name      String      @unique @db.VarChar(64)
  slug      String      @unique @db.VarChar(80)
  postCount Int         @default(0) @map("post_count")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  posts     Post[]
  postLinks PostTopic[]

  @@map("topics")
}

/**
 * 帖子-话题多对多关联（方案 18 §3）：# 解析出的话题全部落这里，Post.topicId 保留主话题兼容旧链路
 */
model PostTopic {
  id        String   @id @default(cuid()) @db.VarChar(64)
  postId    String   @map("post_id") @db.VarChar(64)
  topicId   String   @map("topic_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id])
  topic     Topic    @relation(fields: [topicId], references: [id])

  @@unique([postId, topicId])
  @@index([topicId])
  @@map("post_topics")
}

model Post {
  id             String             @id @default(cuid()) @db.VarChar(64)
  userId         String             @map("user_id") @db.VarChar(64)
  topicId        String?            @map("topic_id") @db.VarChar(64)
  relatedNovelId String?            @map("related_novel_id") @db.VarChar(64)
  /**
   * 分享的作者（分享作者主页到社区时写入）
   */
  sharedUserId   String?            @map("shared_user_id") @db.VarChar(64)
  content        String
  excerpt        String             @db.VarChar(240)
  imageUrls      String[]           @default([]) @map("image_urls")
  likeCount      Int                @default(0) @map("like_count")
  commentCount   Int                @default(0) @map("comment_count")
  favoriteCount  Int                @default(0) @map("favorite_count")
  auditStatus    ContentAuditStatus @default(pending) @map("audit_status")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  author         User               @relation(fields: [userId], references: [id])
  topic          Topic?             @relation(fields: [topicId], references: [id])
  relatedNovel   Novel?             @relation(fields: [relatedNovelId], references: [id])
  sharedUser     User?              @relation("PostSharedUser", fields: [sharedUserId], references: [id])
  comments       Comment[]
  likes          PostLike[]
  bookmarks      PostBookmark[]
  topicLinks     PostTopic[]

  @@index([userId])
  @@index([topicId])
  @@index([relatedNovelId])
  @@index([sharedUserId])
  @@index([createdAt])
  @@index([topicId, createdAt])
  @@index([userId, createdAt])
  @@map("posts")
}

model PostLike {
  id        String   @id @default(cuid()) @db.VarChar(64)
  postId    String   @map("post_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostBookmark {
  id        String   @id @default(cuid()) @db.VarChar(64)
  postId    String   @map("post_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_bookmarks")
}

model UserFollow {
  id          String   @id @default(cuid()) @db.VarChar(64)
  followerId  String   @map("follower_id") @db.VarChar(64)
  followingId String   @map("following_id") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("UserFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model NovelFavorite {
  id        String   @id @default(cuid()) @db.VarChar(64)
  novelId   String   @map("novel_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([novelId, userId])
  @@index([userId])
  @@map("novel_favorites")
}

// 云端书架 + 阅读进度（每个用户对每本书一行）：
// 有记录即在书架中；chapterId 非空表示已开始阅读，scrollPercent 记录章内位置。
// 取代原来仅存 localStorage 的本地书架/进度，实现多设备同步。
model ReadingProgress {
  id            String   @id @default(cuid()) @db.VarChar(64)
  userId        String   @map("user_id") @db.VarChar(64)
  novelId       String   @map("novel_id") @db.VarChar(64)
  novelTitle    String   @map("novel_title") @db.VarChar(128)
  coverUrl      String?  @map("cover_url")
  chapterId     String?  @map("chapter_id") @db.VarChar(64)
  chapterTitle  String?  @map("chapter_title") @db.VarChar(128)
  chapterOrder  Int      @default(0) @map("chapter_order")
  totalChapters Int      @default(0) @map("total_chapters")
  scrollPercent Float    @default(0) @map("scroll_percent")
  addedAt       DateTime @default(now()) @map("added_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel         Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([userId])
  @@map("reading_progress")
}

// 读者去重表（阅读数 UV 化）：一人一作品仅一条，首次阅读写入后重读不累加；
// viewCount 对外语义为「读者数」，与微信读书/Wattpad 的 UV 口径一致。
model NovelRead {
  id        String   @id @default(cuid()) @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  novelId   String   @map("novel_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([novelId])
  @@map("novel_reads")
}

// 阅读器段落划线（方案 20 §2.7）：段级划线，userId+chapterId+paragraphIndex 幂等唯一
model ParagraphUnderline {
  id             String   @id @default(cuid()) @db.VarChar(64)
  userId         String   @map("user_id") @db.VarChar(64)
  novelId        String   @map("novel_id") @db.VarChar(64)
  chapterId      String   @map("chapter_id") @db.VarChar(64)
  paragraphIndex Int      @map("paragraph_index")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter        Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, paragraphIndex])
  @@index([userId, chapterId])
  @@map("paragraph_underlines")
}

// 推荐行为事件（推荐算法优化方案 Phase 1）：
// 统一记录曝光/点击/开始阅读/进度/收藏/完读/弃读/不感兴趣等事件；
// 客户端生成 eventId 幂等去重，服务端入库唯一跳过；
// 只保留作品/用户/行为元数据，不保留正文内容（隐私优先）。
model RecommendationEvent {
  id               String   @id @default(cuid()) @db.VarChar(64)
  eventId          String   @unique @map("event_id") @db.VarChar(64)
  userId           String?  @map("user_id") @db.VarChar(64)
  novelId          String   @map("novel_id") @db.VarChar(64)
  surface          String   @db.VarChar(32)
  position         Int?
  eventType        String   @map("event_type") @db.VarChar(32)
  dwellMs          Int?     @map("dwell_ms")
  progressPercent  Float?   @map("progress_percent")
  sessionId        String?  @map("session_id") @db.VarChar(64)
  algorithmVersion String?  @map("algorithm_version") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at")
  novel            Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([novelId, eventType])
  @@map("recommendation_events")
}

model CommentLike {
  id        String   @id @default(cuid()) @db.VarChar(64)
  commentId String   @map("comment_id") @db.VarChar(64)
  userId    String   @map("user_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
  @@index([userId])
  @@map("comment_likes")
}

model Conversation {
  id                 String               @id @default(cuid()) @db.VarChar(64)
  type               ConversationType     @default(direct)
  title              String?              @db.VarChar(128)
  avatarUrl          String?              @map("avatar_url")
  unreadCount        Int                  @default(0) @map("unread_count")
  lastMessagePreview String?              @map("last_message_preview") @db.VarChar(240)
  lastMessageAt      DateTime?            @map("last_message_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  members            ConversationMember[]
  messages           Message[]

  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(cuid()) @db.VarChar(64)
  conversationId String       @map("conversation_id") @db.VarChar(64)
  userId         String       @map("user_id") @db.VarChar(64)
  joinedAt       DateTime     @default(now()) @map("joined_at")
  lastReadAt     DateTime?    @map("last_read_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid()) @db.VarChar(64)
  conversationId String       @map("conversation_id") @db.VarChar(64)
  senderId       String       @map("sender_id") @db.VarChar(64)
  type           MessageType
  content        String
  relatedId      String?      @map("related_id") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

model CoverAsset {
  id             String          @id @default(cuid()) @db.VarChar(64)
  novelId        String?         @map("novel_id") @db.VarChar(64)
  ownerUserId    String          @map("owner_user_id") @db.VarChar(64)
  sourceType     CoverSourceType @map("source_type")
  imageUrl       String          @map("image_url")
  prompt         String?
  negativePrompt String?         @map("negative_prompt")
  modelName      String?         @map("model_name") @db.VarChar(128)
  width          Int?
  height         Int?
  createdAt      DateTime        @default(now()) @map("created_at")
  owner          User            @relation(fields: [ownerUserId], references: [id])
  novel          Novel?          @relation("CoverAssetCandidates", fields: [novelId], references: [id])
  novelAsCover   Novel?          @relation("NovelCover")

  @@index([ownerUserId])
  @@index([novelId])
  @@map("cover_assets")
}

model AiUsageLog {
  id                String         @id @default(cuid()) @db.VarChar(64)
  userId            String         @map("user_id") @db.VarChar(64)
  novelId           String?        @map("novel_id") @db.VarChar(64)
  chapterId         String?        @map("chapter_id") @db.VarChar(64)
  coverAssetId      String?        @map("cover_asset_id") @db.VarChar(64)
  targetType        String         @map("target_type") @db.VarChar(32)
  targetId          String?        @map("target_id") @db.VarChar(64)
  providerType      AiProviderType @map("provider_type")
  providerMode      String         @map("provider_mode") @db.VarChar(16)
  providerName      String?        @map("provider_name") @db.VarChar(40)
  modelName         String         @map("model_name") @db.VarChar(128)
  action            String         @db.VarChar(64)
  requestTokens     Int?           @map("request_tokens")
  responseTokens    Int?           @map("response_tokens")
  /** Agent 轮号（targetType=agentRun 时有效；wrapUp 兑底调用为 null） */
  turn              Int?           @map("turn")
  /** 供应商返回的缓存命中/未命中输入 token（DeepSeek 顶层字段或 OpenAI prompt_tokens_details） */
  promptCacheHitTokens  Int?       @map("prompt_cache_hit_tokens")
  promptCacheMissTokens Int?       @map("prompt_cache_miss_tokens")
  /** 主 Agent Run 归属；主循环等于 targetId，子 Agent 指向 parentRunId。 */
  agentRunId        String?        @map("agent_run_id") @db.VarChar(64)
  modelTier         String?        @map("model_tier") @db.VarChar(24)
  multiplierBps     Int            @default(10000) @map("multiplier_bps")
  creditChargeMilli Int            @default(0) @map("credit_charge_milli")
  /// Frozen before a legacy/default text dispatch; null retains historical V1 replay.
  billingSnapshot  Json?          @map("billing_snapshot")
  usageSource      String?        @map("usage_source") @db.VarChar(24)
  billingStatus    String?        @map("billing_status") @db.VarChar(24)
  billingRetryAt   DateTime?      @map("billing_retry_at")
  reservedCreditMilli Int         @default(0) @map("reserved_credit_milli")
  reservationExpiresAt DateTime?  @map("reservation_expires_at")
  billingEvidence Json?          @map("billing_evidence")
  durationMs        Int            @map("duration_ms")
  createdAt         DateTime       @default(now()) @map("created_at")
  user              User           @relation(fields: [userId], references: [id])
  novel             Novel?         @relation(fields: [novelId], references: [id])
  chapter           Chapter?       @relation(fields: [chapterId], references: [id])

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([agentRunId, createdAt])
  @@index([providerName, modelName, createdAt])
  @@index([billingStatus, billingRetryAt])
  @@index([userId, reservationExpiresAt])
  @@map("ai_usage_logs")
}

/// 用户额度账户。金额统一使用 milli-credit（1000 milli = 1 Credit），避免浮点误差。
model CreditAccount {
  userId              String    @id @map("user_id") @db.VarChar(64)
  dailyAllowanceMilli Int       @default(450000) @map("daily_allowance_milli")
  dailyUsedMilli      Int       @default(0) @map("daily_used_milli")
  bonusBalanceMilli   Int       @default(0) @map("bonus_balance_milli")
  periodStartedAt     DateTime  @map("period_started_at")
  periodEndsAt        DateTime  @map("period_ends_at")
  suspendedAt         DateTime? @map("suspended_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([periodEndsAt])
  @@index([suspendedAt])
  @@map("credit_accounts")
}

/// 额度不可变账本：消费为负，邀请/管理员补发为正；idempotencyKey 防止网络重试重复扣款。
model CreditLedgerEntry {
  id              String   @id @default(cuid()) @db.VarChar(64)
  userId          String   @map("user_id") @db.VarChar(64)
  deltaMilli      Int      @map("delta_milli")
  dailyDeltaMilli Int      @default(0) @map("daily_delta_milli")
  bonusDeltaMilli Int      @default(0) @map("bonus_delta_milli")
  kind            String   @db.VarChar(32)
  sourceType      String   @map("source_type") @db.VarChar(40)
  referenceId     String?  @map("reference_id") @db.VarChar(96)
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(160)
  modelTier       String?  @map("model_tier") @db.VarChar(24)
  multiplierBps   Int      @default(10000) @map("multiplier_bps")
  requestTokens   Int?     @map("request_tokens")
  responseTokens  Int?     @map("response_tokens")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refundIntent    CreditRefundIntent?

  @@index([userId, createdAt])
  @@index([sourceType, createdAt])
  @@map("credit_ledger_entries")
}

/// Durable obligation, separate from provider cost and from the credited ledger.
model CreditRefundIntent {
  originalEntryId String @id @map("original_entry_id") @db.VarChar(64)
  reason          String @db.VarChar(64)
  evidence        Json
  attempts        Int @default(0)
  nextAttemptAt   DateTime @default(now()) @map("next_attempt_at")
  createdAt       DateTime @default(now()) @map("created_at")
  settledAt       DateTime? @map("settled_at")
  originalEntry   CreditLedgerEntry @relation(fields: [originalEntryId], references: [id], onDelete: Cascade)

  @@index([settledAt, nextAttemptAt])
  @@map("credit_refund_intents")
}

model ReferralCode {
  userId      String               @id @map("user_id") @db.VarChar(64)
  code        String               @unique @db.VarChar(24)
  createdAt   DateTime             @default(now()) @map("created_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]

  @@map("referral_codes")
}

model ReferralRedemption {
  id                 String       @id @default(cuid()) @db.VarChar(64)
  code               String       @db.VarChar(24)
  inviterUserId      String       @map("inviter_user_id") @db.VarChar(64)
  inviteeUserId      String       @unique @map("invitee_user_id") @db.VarChar(64)
  inviterRewardMilli Int          @default(300000) @map("inviter_reward_milli")
  inviteeRewardMilli Int          @default(120000) @map("invitee_reward_milli")
  createdAt          DateTime     @default(now()) @map("created_at")
  referralCode       ReferralCode @relation(fields: [code], references: [code], onDelete: Restrict)
  inviter            User         @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee            User         @relation("ReferralInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([inviterUserId, createdAt])
  @@index([code])
  @@map("referral_redemptions")
}

/// 额度系统全局开关与公测默认值。固定使用 id=global 的单例记录。
model CreditSystemSetting {
  id                  String   @id @db.VarChar(32)
  globallyPaused      Boolean  @default(false) @map("globally_paused")
  dailyAllowanceMilli Int      @default(450000) @map("daily_allowance_milli")
  resetHourUtc8       Int      @default(15) @map("reset_hour_utc8")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("credit_system_settings")
}

/// 不可变产品费率快照；状态变化另记审计事件。
model CreditRateCard {
  id          String @id @db.VarChar(64)
  modelTier   String @map("model_tier") @db.VarChar(24)
  status      String @default("draft") @db.VarChar(24)
  price       Json
  priceHash   String @map("price_hash") @db.VarChar(64)
  createdBy   String @map("created_by") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at")
  revision    Int @default(0)
  events      CreditRateCardEvent[]

  @@index([modelTier, status])
  @@map("credit_rate_cards")
}

model CreditRateCardEvent {
  id          String @id @db.VarChar(64)
  rateCardId  String @map("rate_card_id") @db.VarChar(64)
  revision    Int
  status      String @db.VarChar(24)
  actorId     String @map("actor_id") @db.VarChar(64)
  evidence    Json
  createdAt   DateTime @default(now()) @map("created_at")
  card        CreditRateCard @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  @@unique([rateCardId, revision])
  @@map("credit_rate_card_events")
}

/// 平台内置模型与用户 BYOK 模型共用配置表。真实 modelName/API Key 永不进入用户侧契约。
model AiModelConfig {
  id               String   @id @default(cuid()) @db.VarChar(64)
  ownerUserId      String?  @map("owner_user_id") @db.VarChar(64)
  key              String   @unique @db.VarChar(96)
  provider         String   @db.VarChar(40)
  displayName      String   @map("display_name") @db.VarChar(80)
  modelName        String   @map("model_name") @db.VarChar(160)
  baseUrl          String?  @map("base_url") @db.VarChar(512)
  apiKeyCiphertext String?  @map("api_key_ciphertext")
  tier             String?  @db.VarChar(24)
  multiplierBps    Int      @default(10000) @map("multiplier_bps")
  enabled          Boolean  @default(true)
  selectable       Boolean  @default(true)
