  @@index([tier, enabled, selectable])
  @@map("ai_model_configs")
}

model AgentSession {
  id                 String              @id @default(cuid()) @db.VarChar(64)
  userId             String              @map("user_id") @db.VarChar(64)
  novelId            String              @map("novel_id") @db.VarChar(64)
  title              String              @db.VarChar(160)
  status             AgentSessionStatus  @default(active)
  pinnedAt           DateTime?           @map("pinned_at")
  toolPolicy         Json?               @map("tool_policy")
  sandboxMode        String              @default("workspace") @map("sandbox_mode") @db.VarChar(24)
  lastRunAt          DateTime?           @map("last_run_at")
  // 任务分支溯源：只存 id 不建外键，源任务被删后分支仍独立可用（分支即完整副本）
  forkedFromSessionId String?            @map("forked_from_session_id") @db.VarChar(64)
  /** 从哪条对话切出的分支；整任务复制时为空 */
  forkedFromMessageId String?            @map("forked_from_message_id") @db.VarChar(64)
  /** 切分支的时刻：晚于它的消息即分支内新增对话，用于收起「从聊天中继续」提示 */
  forkedAt           DateTime?           @map("forked_at")
  // 跨任务编排派生溯源：非空即该任务窗口由另一任务的 task_spawn 创建，
  // loop 组装工具时据此剥除编排工具，防止派生窗口再派生形成并发爆炸
  spawnedFromSessionId String?           @map("spawned_from_session_id") @db.VarChar(64)
  /** 派生它的那个 run：供作者回溯是哪轮编排拉起的分支 */
  spawnedFromRunId   String?             @map("spawned_from_run_id") @db.VarChar(64)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  user               User                @relation(fields: [userId], references: [id])
  novel              Novel               @relation(fields: [novelId], references: [id])
  runs               AgentRun[]
  directives         UserDirective[]
  contextCheckpoints ContextCheckpoint[]
  parentSubtasks     AgentSubtask[]       @relation("ParentAgentSubtask")
  childSubtasks      AgentSubtask[]       @relation("ChildAgentSubtask")
  schedules          AgentSchedule[]
  queuedRequests     AgentQueuedRequest[]

  @@index([userId, novelId])
  @@index([novelId, updatedAt])
  @@index([forkedFromSessionId])
  @@index([spawnedFromSessionId])
  @@map("agent_sessions")
}

model AgentQueuedRequest {
