  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel                  Novel           @relation(fields: [novelId], references: [id], onDelete: Cascade)
  run                    AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  matchedPassage         CorpusPassage?  @relation(fields: [matchedPassageId], references: [id], onDelete: SetNull)

  @@index([userId, novelId, createdAt])
  @@index([runId, decision])
  @@index([matchedPassageId])
  @@map("leakage_checks")
}

model CorpusDeletionReceipt {
  id            String       @id @default(cuid()) @db.VarChar(64)
  userId        String?      @map("user_id") @db.VarChar(64)
  novelId       String?      @map("novel_id") @db.VarChar(64)
  sourceId      String       @map("source_id") @db.VarChar(64)
  deletedCounts Json         @map("deleted_counts")
  reason        String       @db.VarChar(500)
  receiptHash   String       @unique @map("receipt_hash") @db.VarChar(64)
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  novel         Novel?       @relation(fields: [novelId], references: [id], onDelete: SetNull)
  source        CorpusSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([userId, novelId, createdAt])
  @@index([sourceId, createdAt])
  @@map("corpus_deletion_receipts")
}

/**
 * 后台管理操作审计日志：只增不删，admin_id 不做外键（避免用户删除产生悬挂）
 */
model AdminAuditLog {
  id         String   @id @default(cuid()) @db.VarChar(64)
  adminId    String   @map("admin_id") @db.VarChar(64)
  action     String   @db.VarChar(64)
  targetType String?  @map("target_type") @db.VarChar(32)
  targetId   String?  @map("target_id") @db.VarChar(64)
  detail     Json     @default("{}")
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model AgentEvalSuite {
  id               String            @id @default(cuid()) @db.VarChar(64)
  name             String            @db.VarChar(160)
  datasetVersion   String            @map("dataset_version") @db.VarChar(64)
  rubricVersion    String            @map("rubric_version") @db.VarChar(64)
  status           String            @default("draft") @db.VarChar(24)
  createdByAdminId String            @map("created_by_admin_id") @db.VarChar(64)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  samples          AgentEvalSample[]

  @@index([status, createdAt])
  @@map("agent_eval_suites")
}

model AgentEvalSample {
  id                  String               @id @default(cuid()) @db.VarChar(64)
  suiteId             String               @map("suite_id") @db.VarChar(64)
  code                String               @db.VarChar(64)
  title               String               @db.VarChar(160)
  genre               String               @db.VarChar(48)
  task                String               @db.VarChar(48)
  style               String               @db.VarChar(48)
  evaluationBrief     String               @map("evaluation_brief")
  sourceClass         String               @map("source_class") @db.VarChar(32)
  sourceReferenceHash String               @map("source_reference_hash") @db.VarChar(64)
  consentReceiptId    String?              @map("consent_receipt_id") @db.VarChar(160)
  createdAt           DateTime             @default(now()) @map("created_at")
  suite               AgentEvalSuite       @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  candidates          AgentEvalCandidate[]
  reviews             AgentBlindReview[]

  @@unique([suiteId, code])
  @@index([suiteId, createdAt])
  @@map("agent_eval_samples")
}

model AgentEvalCandidate {
  id          String          @id @default(cuid()) @db.VarChar(64)
  sampleId    String          @map("sample_id") @db.VarChar(64)
  blindLabel  String          @map("blind_label") @db.VarChar(8)
  origin      String          @db.VarChar(24)
  content     String
  contentHash String          @map("content_hash") @db.VarChar(64)
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at")
  sample      AgentEvalSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, blindLabel])
  @@index([sampleId, origin])
  @@map("agent_eval_candidates")
}

model AgentBlindReview {
  id                String          @id @default(cuid()) @db.VarChar(64)
  sampleId          String          @map("sample_id") @db.VarChar(64)
  reviewerHash      String          @map("reviewer_hash") @db.VarChar(64)
  candidateRatings  Json            @map("candidate_ratings")
  guessedOrigins    Json            @map("guessed_origins")
  mechanicalReasons Json            @map("mechanical_reasons")
  preferredLabel    String          @map("preferred_label") @db.VarChar(8)
  notes             String?
  submittedAt       DateTime        @default(now()) @map("submitted_at")
  sample            AgentEvalSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, reviewerHash])
  @@index([reviewerHash, submittedAt])
  @@map("agent_blind_reviews")
}

/// 用户反馈类别：问题反馈 / 功能建议
enum FeedbackKind {
  bug
  suggestion
}

/// 用户反馈处理状态：待处理 / 已采纳 / 已忽略（后两者可撤销回 pending）
enum FeedbackStatus {
  pending
  accepted
  ignored
}

model Feedback {
  id               String         @id @default(cuid()) @db.VarChar(64)
  userId           String         @map("user_id") @db.VarChar(64)
  kind             FeedbackKind
  status           FeedbackStatus @default(pending)
  content          String
  /**
   * 联系方式（邮箱/手机号/微信/QQ 等，用户自填，可空）
   */
  contact          String?        @db.VarChar(160)
  imageUrls        String[]       @default([]) @map("image_urls")
  /**
   * 提交来源标记（如 studio-work / studio-ide / studio-mobile），用于定位问题场景
   */
  source           String?        @db.VarChar(64)
  pageUrl          String?        @map("page_url") @db.VarChar(500)
  /**
   * 客户端环境快照（UA、视口、主题等），便于复现问题
   */
  clientInfo       Json           @default("{}") @map("client_info")
  handledByAdminId String?        @map("handled_by_admin_id") @db.VarChar(64)
  handledAt        DateTime?      @map("handled_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([kind, status, createdAt])
  @@index([userId, createdAt])
  @@map("feedbacks")
}

// Import-local paid suggestions are single-dispatch and never rewrite source text.
model NovelImportSuggestion {
  id String @id @db.VarChar(64)
  jobId String @db.VarChar(64)
  userId String @db.VarChar(64)
  manifestRevision Int
  manifestHash String @db.VarChar(64)
  fingerprint String @db.VarChar(64)
  volumeIndex Int
  chapterIndex Int
  status String @default("pending") @db.VarChar(24)
  result Json?
  errorCode String? @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([jobId, manifestRevision, volumeIndex, chapterIndex])
  @@index([jobId, createdAt])
  @@map("novel_import_suggestions")
}
